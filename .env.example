# ==============================================================================
# AL MUBARMAJA - PRODUCTION / LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place real secrets, passwords, or private keys in this template.
# ==============================================================================

# --- FRONTEND ENVIRONMENT VARIABLES ---
# In production on Cloudflare, set this to your deployed Railway backend URL:
# Example: NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
NEXT_PUBLIC_API_URL=

# --- BACKEND ENVIRONMENT VARIABLES (Configured on Railway) ---
# Server port (Provided automatically by Railway in production)
PORT=5000

# Environment mode: development / production / test
NODE_ENV=development

# MySQL Database connection string (e.g. mysql://USER:PASSWORD@HOST:PORT/DATABASE)
DATABASE_URL=

# Strong secret key for signing JWT authentication tokens
JWT_SECRET=

# Public Frontend URL (used to generate email verification & password reset links)
APP_URL=

# Public Customer Vehicle Tracking URL (included in SMS/WhatsApp messages)
CUSTOMER_TRACKING_URL=

# Resend API Key for sending verification and transactional emails
RESEND_API_KEY=

# Sender email header (e.g. AL MUBARMAJA <noreply@yourdomain.com>)
EMAIL_FROM=

# Notification provider: sms / whatsapp
NOTIFICATION_PROVIDER=
