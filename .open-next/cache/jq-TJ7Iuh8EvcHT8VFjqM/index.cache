{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"__variable_f367f3 __variable_2c607e scroll-smooth\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7b6d89237bd3f96f.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-ce8f80c3f7646696.js\"/><script src=\"/_next/static/chunks/fd9d1056-199cba9879f49bf4.js\" async=\"\"></script><script src=\"/_next/static/chunks/23-0daeb1c9a7723aac.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f2fc9ec8b7ecffc9.js\" async=\"\"></script><script src=\"/_next/static/chunks/655-2c75146f0e885dd8.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-7b4b74350cdc2498.js\" async=\"\"></script><title>Vantara | The Journey Behind Every Repair</title><meta name=\"description\" content=\"Vantara is a modern digital platform for vehicle workshops to manage every vehicle that enters the workshop.\"/><script src=\"/_next/static/chunks/polyfills-78c92fac7aa8fdd8.js\" noModule=\"\"></script></head><body class=\"bg-background text-foreground font-sans selection:bg-primary/30 selection:text-primary overflow-x-hidden\"><main class=\"w-full bg-background min-h-screen text-foreground selection:bg-primary/30\"><header class=\"fixed top-0 w-full z-50 transition-all duration-300 bg-transparent py-6\"><div class=\"max-w-7xl mx-auto px-6 flex items-center justify-between\"><a class=\"flex items-center gap-2 group\" href=\"/\"><div class=\"w-8 h-8 rounded bg-surface-100 border border-white/10 flex items-center justify-center group-hover:border-primary/50 transition-colors\"><span class=\"font-display text-primary text-xl leading-none mt-1\">V</span></div><span class=\"font-display text-2xl tracking-widest uppercase\">Vantara</span></a><nav class=\"hidden md:flex items-center gap-8\"><a class=\"text-sm font-medium text-secondary hover:text-foreground transition-colors\" href=\"#how-it-works\">How It Works</a><a class=\"text-sm font-medium text-secondary hover:text-foreground transition-colors\" href=\"#features\">Features</a><a class=\"text-sm font-medium text-secondary hover:text-foreground transition-colors\" href=\"#about\">About</a></nav><div class=\"hidden md:flex items-center gap-6\"><a class=\"px-5 py-2.5 bg-transparent border border-white/20 text-foreground font-semibold text-sm rounded hover:bg-white/5 transition-colors\" href=\"/track\">Check Vehicle Status</a><a class=\"px-5 py-2.5 bg-primary text-black font-semibold text-sm rounded hover:bg-primary/90 transition-colors shadow-[0_0_20px_rgba(212,175,55,0.2)]\" href=\"/login\">Workshop Login</a></div><button class=\"md:hidden text-secondary hover:text-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\"><line x1=\"4\" x2=\"20\" y1=\"12\" y2=\"12\"></line><line x1=\"4\" x2=\"20\" y1=\"6\" y2=\"6\"></line><line x1=\"4\" x2=\"20\" y1=\"18\" y2=\"18\"></line></svg></button></div></header><section class=\"relative min-h-[90vh] flex items-center justify-center pt-32 pb-20 overflow-hidden\"><div class=\"absolute inset-0 z-0 pointer-events-none flex justify-center items-center opacity-20\"><div class=\"w-[800px] h-[800px] rounded-full border border-white/5 absolute\"></div><div class=\"w-[600px] h-[600px] rounded-full border border-white/5 absolute\"></div><div class=\"w-[400px] h-[400px] rounded-full border border-primary/20 absolute blur-[1px]\"></div><div class=\"absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:100px_100px]\"></div><div class=\"absolute inset-0 bg-gradient-to-t from-background via-background/80 to-transparent\"></div><div class=\"absolute inset-0 bg-gradient-to-b from-background via-transparent to-transparent\"></div></div><div class=\"max-w-7xl mx-auto px-6 relative z-10 w-full flex flex-col items-center text-center\"><div class=\"mb-6 flex items-center gap-3 bg-surface-100 border border-white/10 px-4 py-1.5 rounded-full shadow-lg\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"w-2 h-2 rounded-full bg-primary animate-pulse\"></div><span class=\"text-xs font-medium tracking-widest uppercase text-secondary\">Vantara OS 1.0</span></div><h1 class=\"text-5xl md:text-7xl lg:text-8xl font-display font-bold uppercase tracking-tight mb-8 leading-[0.9]\" style=\"opacity:0;transform:translateY(30px)\">The Journey Behind <br/><span class=\"text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary/60\">Every Repair.</span></h1><p class=\"text-lg md:text-xl text-secondary max-w-2xl mb-12 leading-relaxed\" style=\"opacity:0;transform:translateY(30px)\">From the moment your vehicle arrives to the moment it leaves, Vantara keeps every detail of its journey connected.</p><div class=\"flex flex-col sm:flex-row items-center gap-4\" style=\"opacity:0;transform:translateY(30px)\"><a class=\"px-8 py-4 bg-primary text-black font-semibold rounded hover:bg-primary/90 transition-all w-full sm:w-auto shadow-[0_0_30px_rgba(212,175,55,0.15)] hover:shadow-[0_0_40px_rgba(212,175,55,0.3)] text-center\" href=\"/login\">OPEN YOUR WORKSHOP</a><a class=\"px-8 py-4 bg-surface-100 border border-white/10 text-foreground font-semibold rounded hover:bg-surface-200 transition-colors w-full sm:w-auto flex items-center justify-center gap-2\" href=\"/track\">CHECK YOUR VEHICLE <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right text-secondary\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"mt-24 relative w-full max-w-4xl h-[300px] md:h-[400px] border border-white/10 bg-surface-50 rounded-2xl overflow-hidden shadow-2xl flex items-center justify-center group\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"absolute inset-0 bg-gradient-to-tr from-accent-steel/10 via-transparent to-primary/5\"></div><div class=\"relative w-full h-full flex items-center justify-center opacity-80\"><svg width=\"600\" height=\"200\" viewBox=\"0 0 600 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full h-auto px-10\"><path d=\"M100 150 L150 80 L450 80 L500 150\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"2\" fill=\"none\"></path><path d=\"M50 150 L550 150\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"2\" stroke-dasharray=\"4 4\"></path><line x1=\"150\" y1=\"80\" x2=\"150\" y2=\"150\" stroke=\"#D4AF37\" stroke-width=\"1\"></line></svg></div><div class=\"absolute top-10 left-10 text-left opacity-0 group-hover:opacity-100 transition-opacity duration-500\"><div class=\"text-[10px] font-mono text-primary mb-1\">SYS.DIAG_01</div><div class=\"text-xs text-secondary\">Engine Bay Scan</div></div><div class=\"absolute bottom-10 right-10 text-right opacity-0 group-hover:opacity-100 transition-opacity duration-500\"><div class=\"text-[10px] font-mono text-accent-steel mb-1\">TELEMETRY_SYNC</div><div class=\"text-xs text-secondary\">Data Link Active</div></div><div class=\"absolute -right-4 md:right-10 top-1/2 -translate-y-1/2 bg-surface-100/90 backdrop-blur-md border border-white/10 p-4 rounded-xl shadow-xl flex flex-col gap-3\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex items-center gap-2\"><div class=\"w-2 h-2 rounded-full bg-primary animate-pulse\"></div><span class=\"text-xs font-medium uppercase tracking-widest text-secondary\">Current Journey</span></div><div class=\"flex justify-between items-end gap-6\"><span class=\"text-sm font-medium\">Repair in progress</span><span class=\"font-display text-xl text-primary\">68%</span></div><div class=\"w-full h-1 bg-white/10 rounded-full overflow-hidden\"><div class=\"h-full bg-primary rounded-full\" style=\"width:0px\"></div></div></div></div><p class=\"mt-12 text-sm text-secondary uppercase tracking-widest font-medium\" style=\"opacity:0;transform:translateY(30px)\">From the moment a vehicle arrives to the moment it leaves, Vantara keeps every detail connected.</p></div></section><section class=\"py-24 relative overflow-hidden bg-background border-t border-white/5\"><div class=\"max-w-7xl mx-auto px-6\"><div class=\"text-center mb-16\"><h2 class=\"text-4xl md:text-5xl font-display font-bold uppercase mb-4\" style=\"opacity:0;transform:translateY(30px)\">Where is your vehicle now?</h2><p class=\"text-xl text-secondary max-w-2xl mx-auto\" style=\"opacity:0;transform:translateY(30px)\">Your vehicle is on its own journey. Check its current repair status using the private tracking details provided by your workshop.</p></div><div class=\"max-w-5xl mx-auto bg-surface-50 border border-white/10 rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"w-full md:w-1/2 bg-[#0a0a0a] relative p-12 flex flex-col justify-between overflow-hidden border-b md:border-b-0 md:border-r border-white/5\"><div class=\"absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-50\"></div><div class=\"relative z-10\"><div class=\"text-[10px] font-mono tracking-widest text-primary uppercase mb-4 border border-primary/20 bg-primary/10 inline-block px-3 py-1 rounded-full\">Customer Vehicle Tracking</div><p class=\"text-secondary max-w-sm text-lg font-medium\">Follow your vehicle&#x27;s journey without calling the workshop.</p></div><div class=\"relative mt-12 w-full h-48 flex items-center justify-center opacity-70\"><svg width=\"100%\" height=\"100%\" viewBox=\"0 0 400 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M50 150 L100 80 L300 80 L350 150\" stroke=\"rgba(255,255,255,0.2)\" stroke-width=\"2\" fill=\"none\"></path><path d=\"M20 150 L380 150\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"2\" stroke-dasharray=\"4 4\"></path><circle cx=\"100\" cy=\"150\" r=\"25\" stroke=\"rgba(212,175,55,0.5)\" stroke-width=\"2\" fill=\"none\"></circle><circle cx=\"300\" cy=\"150\" r=\"25\" stroke=\"rgba(212,175,55,0.5)\" stroke-width=\"2\" fill=\"none\"></circle></svg></div></div><div class=\"w-full md:w-1/2 p-10 md:p-12\"><h3 class=\"text-2xl font-display uppercase tracking-wider mb-8 text-white\">Track Your Vehicle</h3><form class=\"space-y-6\"><div class=\"space-y-2\"><label class=\"text-xs font-medium uppercase tracking-wider text-secondary\">Vantara Tracking Code</label><input type=\"text\" required=\"\" placeholder=\"[ Enter your tracking code ]\" class=\"w-full bg-background border border-white/10 rounded-lg px-4 py-4 font-mono tracking-widest text-sm focus:outline-none focus:border-primary/50 transition-all uppercase placeholder-white/20\" value=\"\"/></div><div class=\"space-y-2\"><label class=\"text-xs font-medium uppercase tracking-wider text-secondary\">Registered Phone Number</label><input type=\"tel\" required=\"\" placeholder=\"[ Enter your phone number ]\" class=\"w-full bg-background border border-white/10 rounded-lg px-4 py-4 text-sm focus:outline-none focus:border-primary/50 transition-all placeholder-white/20\" value=\"\"/></div><button type=\"submit\" class=\"w-full bg-surface-200 border border-white/10 hover:border-primary/50 hover:bg-surface-300 text-white font-semibold rounded-lg py-4 transition-all flex items-center justify-center gap-2 uppercase tracking-wider text-sm mt-4 group\">Check Vehicle Status <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right text-secondary group-hover:text-primary transition-colors\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></form><div class=\"mt-8 flex items-start gap-3 p-4 bg-background border border-white/5 rounded-lg text-secondary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-key shrink-0 mt-0.5\"><path d=\"m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4\"></path><path d=\"m21 2-9.6 9.6\"></path><circle cx=\"7.5\" cy=\"15.5\" r=\"5.5\"></circle></svg><p class=\"text-xs leading-relaxed\">Your tracking code is private and is provided by your workshop.</p></div></div></div></div></section><section class=\"py-24 border-t border-white/5 bg-surface-50\"><div class=\"max-w-7xl mx-auto px-6\"><div class=\"max-w-3xl mb-20\" style=\"opacity:0;transform:translateY(30px)\"><h2 class=\"text-4xl md:text-5xl font-display font-bold uppercase mb-6\">Every vehicle has a story.</h2><p class=\"text-xl text-secondary leading-relaxed\">Complaints get written on paper.<br/>Repair updates get lost in conversations.<br/>Costs change during the job.<br/>Customers call to ask what is happening.<br/><br/><span class=\"text-foreground font-medium\">Vantara turns that scattered process into one connected journey.</span></p></div><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\"><div class=\"p-8 border border-white/5 bg-background rounded-xl hover:border-primary/20 transition-colors group\" style=\"opacity:0;transform:translateY(30px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-list w-8 h-8 text-secondary group-hover:text-primary transition-colors mb-6\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"M12 11h4\"></path><path d=\"M12 16h4\"></path><path d=\"M8 11h.01\"></path><path d=\"M8 16h.01\"></path></svg><h3 class=\"text-lg font-medium mb-3 uppercase tracking-wider\">Complaints</h3><p class=\"text-sm text-secondary leading-relaxed\">Know exactly what the customer reported.</p></div><div class=\"p-8 border border-white/5 bg-background rounded-xl hover:border-primary/20 transition-colors group\" style=\"opacity:0;transform:translateY(30px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wrench w-8 h-8 text-secondary group-hover:text-primary transition-colors mb-6\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"></path></svg><h3 class=\"text-lg font-medium mb-3 uppercase tracking-wider\">Repairs</h3><p class=\"text-sm text-secondary leading-relaxed\">Track what has been diagnosed and completed.</p></div><div class=\"p-8 border border-white/5 bg-background rounded-xl hover:border-primary/20 transition-colors group\" style=\"opacity:0;transform:translateY(30px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-indian-rupee w-8 h-8 text-secondary group-hover:text-primary transition-colors mb-6\"><path d=\"M6 3h12\"></path><path d=\"M6 8h12\"></path><path d=\"m6 13 8.5 8\"></path><path d=\"M6 13h3\"></path><path d=\"M9 13c6.667 0 6.667-10 0-10\"></path></svg><h3 class=\"text-lg font-medium mb-3 uppercase tracking-wider\">Costs</h3><p class=\"text-sm text-secondary leading-relaxed\">Keep parts, labor, and total repair costs visible.</p></div><div class=\"p-8 border border-white/5 bg-background rounded-xl hover:border-primary/20 transition-colors group\" style=\"opacity:0;transform:translateY(30px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity w-8 h-8 text-secondary group-hover:text-primary transition-colors mb-6\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg><h3 class=\"text-lg font-medium mb-3 uppercase tracking-wider\">Progress</h3><p class=\"text-sm text-secondary leading-relaxed\">Know exactly where every vehicle stands.</p></div></div></div></section><section id=\"how-it-works\" class=\"py-32 overflow-hidden relative\"><div class=\"absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent pointer-events-none\"></div><div class=\"max-w-7xl mx-auto px-6 mb-16 text-center\"><h2 class=\"text-4xl md:text-5xl font-display font-bold uppercase\" style=\"opacity:0;transform:translateY(30px)\">One vehicle. One journey.</h2></div><div class=\"relative w-full overflow-x-auto pb-12 hide-scrollbar px-6\"><div class=\"min-w-[1000px] max-w-7xl mx-auto relative flex items-center justify-between py-10\"><div class=\"absolute top-1/2 left-0 right-0 h-px bg-white/10 -translate-y-1/2 z-0\"></div><div class=\"relative z-10 flex flex-col items-center gap-4 group\" style=\"opacity:0;transform:scale(0.8)\"><div class=\"w-12 h-12 rounded-full bg-surface-100 border border-white/10 flex items-center justify-center group-hover:border-primary group-hover:bg-primary/10 transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-5 h-5 text-secondary group-hover:text-primary transition-colors\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg></div><span class=\"text-xs font-medium uppercase tracking-widest text-secondary group-hover:text-foreground transition-colors text-center w-24\">Vehicle Arrives</span></div><div class=\"relative z-10 flex flex-col items-center gap-4 group\" style=\"opacity:0;transform:scale(0.8)\"><div class=\"w-12 h-12 rounded-full bg-surface-100 border border-white/10 flex items-center justify-center group-hover:border-primary group-hover:bg-primary/10 transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search w-5 h-5 text-secondary group-hover:text-primary transition-colors\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg></div><span class=\"text-xs font-medium uppercase tracking-widest text-secondary group-hover:text-foreground transition-colors text-center w-24\">Inspection</span></div><div class=\"relative z-10 flex flex-col items-center gap-4 group\" style=\"opacity:0;transform:scale(0.8)\"><div class=\"w-12 h-12 rounded-full bg-surface-100 border border-white/10 flex items-center justify-center group-hover:border-primary group-hover:bg-primary/10 transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity w-5 h-5 text-secondary group-hover:text-primary transition-colors\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg></div><span class=\"text-xs font-medium uppercase tracking-widest text-secondary group-hover:text-foreground transition-colors text-center w-24\">Diagnosis</span></div><div class=\"relative z-10 flex flex-col items-center gap-4 group\" style=\"opacity:0;transform:scale(0.8)\"><div class=\"w-12 h-12 rounded-full bg-surface-100 border border-white/10 flex items-center justify-center group-hover:border-primary group-hover:bg-primary/10 transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wrench w-5 h-5 text-secondary group-hover:text-primary transition-colors\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"></path></svg></div><span class=\"text-xs font-medium uppercase tracking-widest text-secondary group-hover:text-foreground transition-colors text-center w-24\">Repair</span></div><div class=\"relative z-10 flex flex-col items-center gap-4 group\" style=\"opacity:0;transform:scale(0.8)\"><div class=\"w-12 h-12 rounded-full bg-surface-100 border border-white/10 flex items-center justify-center group-hover:border-primary group-hover:bg-primary/10 transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-5 h-5 text-secondary group-hover:text-primary transition-colors\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg></div><span class=\"text-xs font-medium uppercase tracking-widest text-secondary group-hover:text-foreground transition-colors text-center w-24\">Quality Check</span></div><div class=\"relative z-10 flex flex-col items-center gap-4 group\" style=\"opacity:0;transform:scale(0.8)\"><div class=\"w-12 h-12 rounded-full bg-surface-100 border border-white/10 flex items-center justify-center group-hover:border-primary group-hover:bg-primary/10 transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye w-5 h-5 text-secondary group-hover:text-primary transition-colors\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></div><span class=\"text-xs font-medium uppercase tracking-widest text-secondary group-hover:text-foreground transition-colors text-center w-24\">Ready</span></div><div class=\"relative z-10 flex flex-col items-center gap-4 group\" style=\"opacity:0;transform:scale(0.8)\"><div class=\"w-12 h-12 rounded-full bg-surface-100 border border-white/10 flex items-center justify-center group-hover:border-primary group-hover:bg-primary/10 transition-all duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-truck w-5 h-5 text-secondary group-hover:text-primary transition-colors\"><path d=\"M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2\"></path><path d=\"M15 18H9\"></path><path d=\"M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14\"></path><circle cx=\"17\" cy=\"18\" r=\"2\"></circle><circle cx=\"7\" cy=\"18\" r=\"2\"></circle></svg></div><span class=\"text-xs font-medium uppercase tracking-widest text-secondary group-hover:text-foreground transition-colors text-center w-24\">Delivered</span></div></div></div></section><section class=\"py-24 bg-surface-50 border-y border-white/5 overflow-hidden\"><div class=\"max-w-7xl mx-auto px-6 mb-16 text-center\"><h2 class=\"text-4xl md:text-5xl font-display font-bold uppercase mb-6\" style=\"opacity:0;transform:translateY(30px)\">See the whole workshop at a glance.</h2></div><div class=\"max-w-6xl mx-auto relative perspective-1000\" style=\"opacity:0;transform:translateY(50px)\"><div class=\"w-full bg-[#121212] border border-white/10 rounded-2xl shadow-2xl overflow-hidden flex flex-col\"><div class=\"h-14 border-b border-white/5 flex items-center px-6 justify-between bg-[#0A0A0A]\"><div class=\"flex items-center gap-4\"><div class=\"w-6 h-6 bg-surface-200 rounded flex items-center justify-center text-xs font-display text-primary\">V</div><span class=\"text-sm font-medium tracking-wide\">Workshop Dashboard</span></div><div class=\"flex items-center gap-4 text-secondary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-settings\"><path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.2