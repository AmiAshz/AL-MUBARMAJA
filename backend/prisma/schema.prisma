generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
  RECEPTIONIST
}

enum VehicleStatus {
  AWAITING_DIAGNOSIS
  IN_PROGRESS
  AWAITING_PARTS
  READY_FOR_PICKUP
  COMPLETED
}

enum EstimateStatus {
  DRAFT
  SENT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

enum EstimateItemType {
  PART
  LABOR
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProgressLogType {
  VEHICLE_RECEIVED
  INSPECTION
  DIAGNOSIS
  ESTIMATE_CREATED
  ESTIMATE_UPDATED
  APPROVAL
  REPAIR_STARTED
  REPAIR_COMPLETED
  ADDITIONAL_REPAIR
  STATUS_CHANGE
  PAYMENT
  NOTE
  QUALITY_CHECK
  READY_FOR_PICKUP
  COMPLETED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String
  phone          String?
  role           UserRole @default(TECHNICIAN)
  emailVerified  Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  inspections         Inspection[]
  repairs             Repair[]
  estimates           Estimate[]
  approvals           Approval[]
  additionalRepairs   AdditionalRepair[]
  progressLogs        ProgressLog[]
  jobStatusHistory    JobStatusHistory[]
  payments              Payment[]
  verificationTokens    VerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  emailLogs             EmailLog[]
  whatsappNotifications WhatsappNotification[]
}

model Vehicle {
  id               String        @id @default(uuid())
  jobNumber        String        @unique // e.g. VNT-000001
  make             String
  model            String
  year             String
  plateNumber      String
  vin              String?
  ownerName        String
  ownerPhone       String
  dateBroughtIn    String
  timeBroughtIn    String?
  initialCondition String?       @db.Text
  status           VehicleStatus @default(AWAITING_DIAGNOSIS)
  trackingCode     String?       @unique
  isTrackingEnabled Boolean      @default(true)
  isFinalCostVisible Boolean     @default(false)
  finalPartsCost   Float?
  finalLaborCost   Float?
  finalOtherCost   Float?
  finalTax         Float?
  finalTotalCost   Float?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Indexes
  @@index([plateNumber])
  @@index([vin])
  @@index([jobNumber])
  @@index([status])
  @@index([ownerName])
  @@index([createdAt])
  @@index([trackingCode])

  // Relations
  complaints        Complaint[]
  inspections       Inspection[]
  repairs           Repair[]
  estimates         Estimate[]
  approvals         Approval[]
  additionalRepairs AdditionalRepair[]
  progressLogs      ProgressLog[]
  jobStatusHistory  JobStatusHistory[]
  payments              Payment[]
  notifications         Notification[]
  whatsappNotifications WhatsappNotification[]
}

model Complaint {
  id          String   @id @default(uuid())
  vehicleId   String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Inspection {
  id             String   @id @default(uuid())
  vehicleId      String
  technicianId   String
  findings       String?  @db.Text
  diagnosis      String?  @db.Text
  recommendation String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Restrict)
}

model Repair {
  id           String    @id @default(uuid())
  vehicleId    String
  description  String    @db.Text
  technicianId String
  status       String
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  technician User    @relation(fields: [technicianId], references: [id], onDelete: Restrict)
}

model Estimate {
  id             String         @id @default(uuid())
  vehicleId      String
  estimateNumber String         @unique
  partsTotal     Float          @default(0)
  laborTotal     Float          @default(0)
  subtotal       Float          @default(0)
  tax            Float          @default(0)
  total          Float          @default(0)
  status         EstimateStatus @default(DRAFT)
  createdById    String
  notes          String?        @db.Text
  isCustomerVisible Boolean     @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vehicle Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  creator User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items   EstimateItem[]
  approvals Approval[]
}

model EstimateItem {
  id          String           @id @default(uuid())
  estimateId  String
  description String           @db.Text
  itemType    EstimateItemType
  quantity    Int              @default(1)
  unitPrice   Float            @default(0)
  total       Float            @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
}

model Approval {
  id           String         @id @default(uuid())
  vehicleId    String
  estimateId   String?
  approvedById String
  status       ApprovalStatus @default(PENDING)
  approvedAt   DateTime?
  notes        String?        @db.Text

  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  estimate   Estimate? @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  approvedBy User      @relation(fields: [approvedById], references: [id], onDelete: Restrict)
}

model AdditionalRepair {
  id             String         @id @default(uuid())
  vehicleId      String
  description    String         @db.Text
  reason         String?        @db.Text
  partsCost      Float          @default(0)
  laborCost      Float          @default(0)
  totalCost      Float          @default(0)
  approvalStatus ApprovalStatus @default(PENDING)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

model ProgressLog {
  id                String          @id @default(uuid())
  vehicleId         String
  userId            String?
  type              ProgressLogType
  message           String          @db.Text
  isCustomerVisible Boolean         @default(false)
  createdAt         DateTime        @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model JobStatusHistory {
  id             String        @id @default(uuid())
  vehicleId      String
  previousStatus VehicleStatus
  newStatus      VehicleStatus
  changedById    String?
  createdAt      DateTime      @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
}

model Payment {
  id            String        @id @default(uuid())
  vehicleId     String
  amount        Float
  paymentMethod PaymentMethod
  reference     String?
  notes         String?       @db.Text
  paidAt        DateTime?
  createdById   String
  createdAt     DateTime      @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

enum NotificationType {
  VEHICLE_REGISTERED
  VEHICLE_RECEIVED
  DIAGNOSIS_COMPLETED
  ESTIMATE_READY
  APPROVAL_REQUIRED
  REPAIR_STARTED
  REPAIR_UPDATE
  AWAITING_PARTS
  READY_FOR_PICKUP
  COMPLETED
  VEHICLE_COMPLETED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id                String             @id @default(uuid())
  vehicleId         String             @map("vehicle_id")
  phoneNumber       String             @map("phone_number")
  messageType       NotificationType   @map("message_type")
  provider          String
  status            NotificationStatus
  providerMessageId String?            @map("provider_message_id")
  sentAt            DateTime?          @map("sent_at")
  failureReason     String?            @map("failure_reason")
  createdAt         DateTime           @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([phoneNumber])
}

// -----------------------------------------------------------------------------
// EMAIL VERIFICATION, PASSWORD RESET & LOGGING
// -----------------------------------------------------------------------------

enum EmailLogType {
  VERIFICATION
  PASSWORD_RESET
  WELCOME
  INVITATION
}

enum EmailLogStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

model VerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLog {
  id                String         @id @default(uuid())
  userId            String?        @map("user_id")
  recipient         String
  type              EmailLogType
  provider          String
  providerMessageId String?        @map("provider_message_id")
  status            EmailLogStatus
  sentAt            DateTime?      @map("sent_at")
  failureReason     String?        @map("failure_reason")
  createdAt         DateTime       @default(now()) @map("created_at")

  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([recipient])
}

// -----------------------------------------------------------------------------
// WHATSAPP NOTIFICATIONS
// -----------------------------------------------------------------------------

enum WhatsappNotificationType {
  TRACKING_DETAILS
  DIAGNOSIS_UPDATE
  ESTIMATE_READY
  REPAIR_STARTED
  AWAITING_PARTS
  READY_FOR_PICKUP
  REPAIR_COMPLETED
}

enum WhatsappNotificationStatus {
  NOT_SENT
  SENT
}

model WhatsappNotification {
  id                String                     @id @default(uuid())
  vehicleId         String                     @map("vehicle_id")
  customerId        String?                    @map("customer_id")
  notificationType  WhatsappNotificationType   @map("notification_type")
  recipientPhone    String                     @map("recipient_phone")
  messageTemplate   String?                    @map("message_template")
  providerMessageId String?                    @map("provider_message_id")
  status            WhatsappNotificationStatus
  sentById          String?                    @map("sent_by")
  sentAt            DateTime?                  @map("sent_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  failureReason     String?                    @map("failure_reason")

  vehicle           Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  sentBy            User?                      @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([recipientPhone])
}
